{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenGVA VNC viewer",
  "version": "0.1.0",
  "identifier": "org.opengva.vnc-viewer",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5183"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "OpenGVA VNC viewer",
        "width": 1024,
        "height": 768,
        "decorations": false,
        "backgroundColor": "#000000"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost ws://127.0.0.1:*"
    }
  },
  "bundle": {
    "active": false
  }
}
