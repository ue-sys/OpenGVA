{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenGVA HMI",
  "version": "0.1.0",
  "identifier": "org.opengva.hmi",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "OpenGVA HMI",
        "width": 1024,
        "height": 768,
        "decorations": false,
        "transparent": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": false
  }
}
