+/* The application's virtual keyboard has gone: so has its group, which was
+ * for that keyboard alone, and the application has the keyboard focus again
+ * unless it has another. */
+static void
+handle_lending_keyboard_destroy(struct wl_listener *listener, void *data)
+{
+	struct cg_keyboard_group *group = wl_container_of(listener, group, lending_destroy);
+	struct cg_seat *seat = group->seat;
+
+	wl_list_remove(&group->lending_destroy.link);
+	keyboard_group_destroy(group);
+	seat_lend_keyboard(seat);
+}
