+/* Give the keyboard focus to whom it belongs. While the application has a
+ * virtual keyboard of its own, that is the view under the application's
+ * that it has on show, if there is one and no more: several are shown side
+ * by side, and then there is no saying which of them a key is for. Otherwise
+ * it is the application's. The view is told of no key that is down: a key
+ * held on another keyboard is none of its business. */
+void
+seat_lend_keyboard(struct cg_seat *seat)
+{
+	struct cg_view *to = NULL;
+	struct cg_keyboard_group *group;
+	wl_list_for_each (group, &seat->keyboard_groups, link) {
+		if (group->lends) {
+			to = view_get_only_shown(seat->server);
+			break;
+		}
+	}
+	if (to == seat->lent_to) {
+		return;
+	}
+
+	seat->lent_to = to;
+	if (!to) {
+		to = view_get_foremost(seat->server);
+	}
+	if (to && to->wlr_surface) {
+		wlr_seat_keyboard_notify_enter(seat->seat, to->wlr_surface, NULL, 0, NULL);
+	} else {
+		wlr_seat_keyboard_notify_clear_focus(seat->seat);
+	}
+}
+
+/* A view that is going from the screen gives back the keyboard focus, if it
+ * had been lent it. */
+void
+seat_take_back_keyboard(struct cg_seat *seat, struct cg_view *from)
+{
+	if (seat->lent_to != from) {
+		return;
+	}
+
+	seat->lent_to = NULL;
+	struct cg_view *foremost = view_get_foremost(seat->server);
+	if (foremost && foremost->wlr_surface) {
+		wlr_seat_keyboard_notify_enter(seat->seat, foremost->wlr_surface, NULL, 0, NULL);
+	} else {
+		wlr_seat_keyboard_notify_clear_focus(seat->seat);
+	}
+}
