+/* Whether what a keyboard does is to be passed on to the client that has
+ * the keyboard focus. What the application's own virtual keyboard types is
+ * for the view it has on show, which has the focus for that, and for nobody
+ * if there is none. What any other keyboard types is the application's, as
+ * it always was, and not for a view that has been lent the focus for what
+ * the application types into it. */
+static bool
+keyboard_passes(struct wlr_keyboard *keyboard, struct cg_seat *seat)
+{
+	struct wlr_keyboard_group *wlr_group = wlr_keyboard_group_from_wlr_keyboard(keyboard);
+	struct cg_keyboard_group *group = wlr_group ? wlr_group->data : NULL;
+	if (group && group->lends) {
+		seat_lend_keyboard(seat);
+		return seat->lent_to != NULL;
+	}
+	return seat->lent_to == NULL;
+}
