+/* The view under the application's that is on show, if there is one and no
+ * more than one. */
+struct cg_view *
+view_get_only_shown(struct cg_server *server)
+{
+	struct cg_view *shown = NULL;
+	struct cg_view *view;
+	wl_list_for_each (view, &server->views, link) {
+		if (view->foremost || !view->wlr_surface || !view->scene_tree || !view->scene_tree->node.enabled) {
+			continue;
+		}
+		if (shown) {
+			return NULL;
+		}
+		shown = view;
+	}
+	return view_get_foremost(server) ? shown : NULL;
+}
+
 /* Show a view that is under the application's, or hide it. Such a view is
- * never given the keyboard, so this is also where it learns whether it is
- * showing. */
+ * given the keyboard only while the application lends it, so this is also
+ * where it learns whether it is showing - and where the keyboard goes to
+ * the view the application now has on show, if it is lending it, and comes
+ * back from one it has hidden. */
 static void
 view_set_shown(struct cg_view *view, bool shown)
 {
+	if (!shown) {
+		seat_take_back_keyboard(view->server->seat, view);
+	}
 	wlr_scene_node_set_enabled(&view->scene_tree->node, shown);
 	view_activate(view, shown);
 	if (view->foreign_toplevel) {
 		wlr_foreign_toplevel_handle_v1_set_minimized(view->foreign_toplevel, !shown);
 		wlr_foreign_toplevel_handle_v1_set_activated(view->foreign_toplevel, shown);
 	}
+	seat_lend_keyboard(view->server->seat);
 }
 
