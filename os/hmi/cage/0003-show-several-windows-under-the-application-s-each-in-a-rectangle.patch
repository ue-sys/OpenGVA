+static void
+handle_foreign_toplevel_set_rectangle(struct wl_listener *listener, void *data)
+{
+	struct cg_view *view = wl_container_of(listener, view, foreign_toplevel_set_rectangle);
+	struct wlr_foreign_toplevel_handle_v1_set_rectangle_event *event = data;
+	struct cg_view *foremost = view_get_foremost(view->server);
+
+	/* Where a view under the application's goes is for the application
+	   to say, and nobody else. The rectangle is taken to be one of the
+	   application's window whichever of its surfaces the request names:
+	   an application that asks over a connection of its own, beside its
+	   toolkit's, has no other name for that window. */
+	if (view->foremost || !foremost ||
+	    !view_client_is_primary(view->server, wl_resource_get_client(event->surface->resource))) {
+		return;
+	}
+
+	/* An empty rectangle takes away the one it had. */
+	struct wlr_box place = {
+		.x = foremost->lx + event->x,
+		.y = foremost->ly + event->y,
+		.width = event->width,
+		.height = event->height,
+	};
+	if (wlr_box_equal(&place, &view->place)) {
+		return;
 	}
+	view->place = wlr_box_empty(&place) ? (struct wlr_box){0} : place;
+	view_position(view);
 }
 
