+/* Whether a view has painted what it says is opaque: the pixel in the middle
+ * of the first rectangle of its opaque region is looked at. A client may say
+ * what is opaque before it has drawn the frame that is true of - a toolkit
+ * commits what it has when it next draws anything - and its window is as
+ * clear as it was until that frame comes. Where the pixel cannot be had, the
+ * client's word is taken. */
+static bool
+view_has_painted(struct cg_view *view)
+{
+	struct wlr_surface *surface = view->wlr_surface;
+	int n;
+	const pixman_box32_t *opaque = pixman_region32_rectangles(&surface->opaque_region, &n);
+	if (n == 0) {
+		return false;
+	}
+	if (!surface->buffer || !surface->buffer->texture || surface->current.buffer_width != surface->current.width ||
+	    surface->current.buffer_height != surface->current.height) {
+		return true;
+	}
+
+	uint8_t pixel[4]; /* red, green, blue, alpha */
+	const struct wlr_texture_read_pixels_options options = {
+		.data = pixel,
+		.format = DRM_FORMAT_ABGR8888,
+		.stride = sizeof(pixel),
+		.src_box = {.x = (opaque->x1 + opaque->x2) / 2,
+			    .y = (opaque->y1 + opaque->y2) / 2,
+			    .width = 1,
+			    .height = 1},
+	};
+	return !wlr_texture_read_pixels(surface->buffer->texture, &options) || pixel[3] == 0xff;
+}
+
+/* The splash is shown until the application has drawn, which is for the
+ * application to say, since a window is mapped before its application has
+ * anything to show in it: until a window of its own - with -u; any window,
+ * without - says that some of itself is opaque, and has painted it so.
+ *
+ * This is asked after a frame has been given to a display, and not when a
+ * window commits: looking at a pixel that a GPU is still drawing waits for
+ * the GPU, and the frame the pixel is in is not to wait for the looking. The
+ * splash is under that frame's windows, then, and gone from the next. */
+void
+view_update_splash(struct cg_server *server)
+{
+	if (!server->splash) {
+		return;
+	}
+
+	struct cg_view *view;
+	wl_list_for_each (view, &server->views, link) {
+		if (view->wlr_surface && (view->foremost || !server->others_under) && view_has_painted(view)) {
+			splash_end(server);
+			return;
+		}
+	}
+}
