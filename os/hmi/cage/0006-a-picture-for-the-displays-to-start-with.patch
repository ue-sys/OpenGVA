diff -Naur a/splash.c b/splash.c
--- a/splash.c
+++ b/splash.c
@@ -0,0 +1,241 @@
+/*
+ * Cage: A Wayland kiosk.
+ *
+ * See the LICENSE file accompanying this file.
+ *
+ * The splash: a picture that every display starts with, in place of
+ * nothing, until the application has drawn.
+ *
+ * The picture is in the middle of the display, and the rest of the display
+ * is the colour of the picture's first pixel: a logo, on a background of its
+ * own that goes on to the edges. It is shown at the largest whole fraction
+ * of its size (all of it, a half, a third ...) that is no wider than half
+ * the display and no taller than the display, each pixel the mean of the
+ * pixels it stands for: as sharp as it was drawn, on a display of any size.
+ * Nothing here is rounded but that mean, so that whatever showed the same
+ * picture before Cage, by the same sums - a boot loader - showed it the
+ * same to the pixel, and nothing is seen to change when Cage takes the
+ * display.
+ */
+
+#define _POSIX_C_SOURCE 200809L
+
+#include <drm_fourcc.h>
+#include <png.h>
+#include <stdint.h>
+#include <stdlib.h>
+#include <wayland-server-core.h>
+#include <wlr/interfaces/wlr_buffer.h>
+#include <wlr/types/wlr_output_layout.h>
+#include <wlr/types/wlr_scene.h>
+#include <wlr/util/log.h>
+
+#include "output.h"
+#include "server.h"
+#include "splash.h"
+
+/* The picture as it was read: four bytes to a pixel - blue, green, red and
+ * one that is not looked at. */
+struct cg_splash {
+	int width, height;
+	uint8_t *pixels;
+};
+
+/* The picture at the size it is shown, for the renderer to read. */
+struct splash_buffer {
+	struct wlr_buffer base;
+	uint8_t *pixels;
+};
+
+static void
+splash_buffer_destroy(struct wlr_buffer *wlr_buffer)
+{
+	struct splash_buffer *buffer = wl_container_of(wlr_buffer, buffer, base);
+	wlr_buffer_finish(wlr_buffer);
+	free(buffer->pixels);
+	free(buffer);
+}
+
+static bool
+splash_buffer_begin_data_ptr_access(struct wlr_buffer *wlr_buffer, uint32_t flags, void **data, uint32_t *format,
+				    size_t *stride)
+{
+	struct splash_buffer *buffer = wl_container_of(wlr_buffer, buffer, base);
+	if (flags & WLR_BUFFER_DATA_PTR_ACCESS_WRITE) {
+		return false;
+	}
+	*data = buffer->pixels;
+	*format = DRM_FORMAT_XRGB8888;
+	*stride = 4 * (size_t) wlr_buffer->width;
+	return true;
+}
+
+static void
+splash_buffer_end_data_ptr_access(struct wlr_buffer *wlr_buffer)
+{
+}
+
+static const struct wlr_buffer_impl splash_buffer_impl = {
+	.destroy = splash_buffer_destroy,
+	.begin_data_ptr_access = splash_buffer_begin_data_ptr_access,
+	.end_data_ptr_access = splash_buffer_end_data_ptr_access,
+};
+
+/* The picture at one n-th of its size. */
+static struct wlr_buffer *
+splash_reduced(const struct cg_splash *splash, int n, int width, int height)
+{
+	struct splash_buffer *buffer = calloc(1, sizeof(struct splash_buffer));
+	uint8_t *pixels = malloc(4 * (size_t) width * height);
+	if (!buffer || !pixels) {
+		free(buffer);
+		free(pixels);
+		return NULL;
+	}
+
+	for (int y = 0; y < height; y++) {
+		for (int x = 0; x < width; x++) {
+			for (int c = 0; c < 4; c++) {
+				unsigned int sum = 0;
+				for (int j = 0; j < n; j++) {
+					const uint8_t *row = splash->pixels + 4 * (size_t) (y * n + j) * splash->width;
+					for (int i = 0; i < n; i++) {
+						sum += row[4 * (x * n + i) + c];
+					}
+				}
+				pixels[4 * ((size_t) y * width + x) + c] = (sum + n * n / 2) / (n * n);
+			}
+		}
+	}
+
+	buffer->pixels = pixels;
+	wlr_buffer_init(&buffer->base, &splash_buffer_impl, width, height);
+	return &buffer->base;
+}
+
+/* Read the picture the displays are to start with: a PNG file. */
+void
+splash_load(struct cg_server *server, const char *path)
+{
+	png_image image = {.version = PNG_IMAGE_VERSION};
+	if (!png_image_begin_read_from_file(&image, path)) {
+		wlr_log(WLR_ERROR, "No splash: %s: %s", path, image.message);
+		return;
+	}
+	image.format = PNG_FORMAT_BGRA;
+
+	struct cg_splash *splash = calloc(1, sizeof(struct cg_splash));
+	uint8_t *pixels = malloc(PNG_IMAGE_SIZE(image));
+	if (!splash || !pixels || !png_image_finish_read(&image, NULL, pixels, 0, NULL)) {
+		wlr_log(WLR_ERROR, "No splash: %s: %s", path, image.message);
+		png_image_free(&image);
+		free(splash);
+		free(pixels);
+		return;
+	}
+
+	splash->width = image.width;
+	splash->height = image.height;
+	splash->pixels = pixels;
+	server->splash = splash;
+}
+
+/* Give a display its splash, or fit the one it has to the display as it is
+ * now: the box is the display's, in the layout. A display that has no place
+ * there has no splash. */
+void
+splash_show(struct cg_output *output, const struct wlr_box *box)
+{
+	struct cg_server *server = output->server;
+	struct cg_splash *splash = server->splash;
+	if (!splash) {
+		return;
+	}
+
+	if (output->splash && output->splash_width == box->width && output->splash_height == box->height) {
+		wlr_scene_node_set_position(&output->splash->node, box->x, box->y);
+		wlr_scene_node_lower_to_bottom(&output->splash->node);
+		return;
+	}
+	if (output->splash) {
+		wlr_scene_node_destroy(&output->splash->node);
+		output->splash = NULL;
+	}
+	if (wlr_box_empty(box)) {
+		return;
+	}
+
+	output->splash = wlr_scene_tree_create(&server->scene->tree);
+	if (!output->splash) {
+		return;
+	}
+	output->splash_width = box->width;
+	output->splash_height = box->height;
+	wlr_scene_node_set_position(&output->splash->node, box->x, box->y);
+	wlr_scene_node_lower_to_bottom(&output->splash->node);
+
+	/* The first pixel's colour, everywhere. */
+	const float colour[4] = {splash->pixels[2] / 255.0f, splash->pixels[1] / 255.0f, splash->pixels[0] / 255.0f,
+				 1.0f};
+	wlr_scene_rect_create(output->splash, box->width, box->height, colour);
+
+	/* One pixel of the display for n by n of the picture. */
+	int n = (2 * splash->width + box->width - 1) / box->width;
+	if (n < (splash->height + box->height - 1) / box->height) {
+		n = (splash->height + box->height - 1) / box->height;
+	}
+	int width = splash->width / n;
+	int height = splash->height / n;
+	if (width == 0 || height == 0) {
+		return;
+	}
+
+	struct wlr_buffer *buffer = splash_reduced(splash, n, width, height);
+	if (!buffer) {
+		return;
+	}
+	struct wlr_scene_buffer *picture = wlr_scene_buffer_create(output->splash, buffer);
+	wlr_buffer_drop(buffer);
+	if (picture) {
+		wlr_scene_node_set_position(&picture->node, (box->width - width) / 2, (box->height - height) / 2);
+	}
+}
+
+/* Put each display's splash where the display is now, at the size it is
+ * now, and under everything else. */
+void
+splash_place(struct cg_server *server)
+{
+	if (!server->splash) {
+		return;
+	}
+
+	struct cg_output *output;
+	wl_list_for_each (output, &server->outputs, link) {
+		struct wlr_box box;
+		wlr_output_layout_get_box(server->output_layout, output->wlr_output, &box);
+		splash_show(output, &box);
+	}
+}
+
+/* The application has drawn: the splash has done its work, and is not shown
+ * again. */
+void
+splash_end(struct cg_server *server)
+{
+	if (!server->splash) {
+		return;
+	}
+
+	struct cg_output *output;
+	wl_list_for_each (output, &server->outputs, link) {
+		if (output->splash) {
+			wlr_scene_node_destroy(&output->splash->node);
+			output->splash = NULL;
+		}
+	}
+
+	free(server->splash->pixels);
+	free(server->splash);
+	server->splash = NULL;
+}
