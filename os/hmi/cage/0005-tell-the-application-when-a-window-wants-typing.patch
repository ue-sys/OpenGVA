+/* Tell the application, as the input method, whether a field of text has
+ * the focus in the view that has the keyboard, and what the field is for:
+ * when one takes the focus, when none has it any more, and - asked - each
+ * time the view says something of the field it has, which is how a field
+ * that is touched again asks again. What the field holds is not passed on:
+ * the application has no use for it. */
+static void
+seat_tell_input_method(struct cg_seat *seat, bool asked)
+{
+	struct wlr_input_method_v2 *input_method = seat->input_method;
+	if (!input_method) {
+		return;
+	}
+
+	struct wlr_text_input_v3 *asking = NULL;
+	struct cg_text_input *text_input;
+	wl_list_for_each (text_input, &seat->text_inputs, link) {
+		if (text_input->text_input->focused_surface && text_input->text_input->current_enabled) {
+			asking = text_input->text_input;
+			break;
+		}
+	}
+
+	if (!asking) {
+		if (!input_method->active) {
+			return;
+		}
+		wlr_input_method_v2_send_deactivate(input_method);
+	} else {
+		if (!input_method->active) {
+			wlr_input_method_v2_send_activate(input_method);
+		} else if (!asked) {
+			return;
+		}
+		if (asking->active_features & WLR_TEXT_INPUT_V3_FEATURE_CONTENT_TYPE) {
+			wlr_input_method_v2_send_content_type(input_method, asking->current.content_type.hint,
+							      asking->current.content_type.purpose);
+		}
+	}
+	wlr_input_method_v2_send_done(input_method);
+}
+
+static void
+handle_text_input_enable(struct wl_listener *listener, void *data)
+{
+	struct cg_text_input *text_input = wl_container_of(listener, text_input, enable);
+	seat_tell_input_method(text_input->seat, true);
+}
+
+static void
+handle_text_input_commit(struct wl_listener *listener, void *data)
+{
+	struct cg_text_input *text_input = wl_container_of(listener, text_input, commit);
+	seat_tell_input_method(text_input->seat, true);
+}
+
+static void
+handle_text_input_disable(struct wl_listener *listener, void *data)
+{
+	struct cg_text_input *text_input = wl_container_of(listener, text_input, disable);
+	seat_tell_input_method(text_input->seat, false);
+}
+
+static void
+handle_text_input_destroy(struct wl_listener *listener, void *data)
+{
+	struct cg_text_input *text_input = wl_container_of(listener, text_input, destroy);
+	struct cg_seat *seat = text_input->seat;
+
+	wl_list_remove(&text_input->enable.link);
+	wl_list_remove(&text_input->commit.link);
+	wl_list_remove(&text_input->disable.link);
+	wl_list_remove(&text_input->destroy.link);
+	wl_list_remove(&text_input->link);
+	free(text_input);
+	seat_tell_input_method(seat, false);
+}
+
+/* A client has a text input: it is told when a surface of the client's has
+ * the keyboard focus, and says when a field of text there has the focus.
+ * The application's own is told nothing: it is the input method, and has no
+ * use for one. */
+static void
+handle_new_text_input(struct wl_listener *listener, void *data)
+{
+	struct cg_seat *seat = wl_container_of(listener, seat, new_text_input);
+	struct wlr_text_input_v3 *wlr_text_input = data;
+	struct wl_client *client = wl_resource_get_client(wlr_text_input->resource);
+	if (view_client_is_primary(seat->server, client)) {
+		return;
+	}
+
+	struct cg_text_input *text_input = calloc(1, sizeof(struct cg_text_input));
+	if (!text_input) {
+		wlr_log(WLR_ERROR, "Failed to allocate text input.");
+		return;
+	}
+	text_input->text_input = wlr_text_input;
+	text_input->seat = seat;
+	text_input->enable.notify = handle_text_input_enable;
+	wl_signal_add(&wlr_text_input->events.enable, &text_input->enable);
+	text_input->commit.notify = handle_text_input_commit;
+	wl_signal_add(&wlr_text_input->events.commit, &text_input->commit);
+	text_input->disable.notify = handle_text_input_disable;
+	wl_signal_add(&wlr_text_input->events.disable, &text_input->disable);
+	text_input->destroy.notify = handle_text_input_destroy;
+	wl_signal_add(&wlr_text_input->events.destroy, &text_input->destroy);
+	wl_list_insert(&seat->text_inputs, &text_input->link);
+
+	struct wlr_surface *focused = seat->seat->keyboard_state.focused_surface;
+	if (focused && wl_resource_get_client(focused->resource) == client) {
+		wlr_text_input_v3_send_enter(wlr_text_input, focused);
+	}
+}
+
+/* The keyboard focus has gone from one surface to another: the text inputs
+ * follow it. One whose field had the focus has it no longer. */
+static void
+handle_keyboard_focus_change(struct wl_listener *listener, void *data)
+{
+	struct cg_seat *seat = wl_container_of(listener, seat, keyboard_focus_change);
+	struct wlr_seat_keyboard_focus_change_event *event = data;
+
+	struct cg_text_input *text_input;
+	wl_list_for_each (text_input, &seat->text_inputs, link) {
+		struct wlr_text_input_v3 *wlr_text_input = text_input->text_input;
+		if (wlr_text_input->focused_surface == event->new_surface) {
+			continue;
+		}
+		if (wlr_text_input->focused_surface) {
+			wlr_text_input_v3_send_leave(wlr_text_input);
+		}
+		if (event->new_surface &&
+		    wl_resource_get_client(event->new_surface->resource) ==
+			    wl_resource_get_client(wlr_text_input->resource)) {
+			wlr_text_input_v3_send_enter(wlr_text_input, event->new_surface);
+		}
+	}
+	seat_tell_input_method(seat, false);
+}
+
+static void
+handle_input_method_destroy(struct wl_listener *listener, void *data)
+{
+	struct cg_seat *seat = wl_container_of(listener, seat, input_method_destroy);
+
+	wl_list_remove(&seat->input_method_destroy.link);
+	seat->input_method = NULL;
+	seat_lend_keyboard(seat);
+}
+
+/* A client would be the input method. The application is the only one that
+ * may, and there is one at the most: any other is told there is no place
+ * for it. From now the view the application has on show has the keyboard
+ * focus for as long as it is on show, which is what lets it have a field of
+ * text with the focus at all. */
+static void
+handle_new_input_method(struct wl_listener *listener, void *data)
+{
+	struct cg_seat *seat = wl_container_of(listener, seat, new_input_method);
+	struct wlr_input_method_v2 *input_method = data;
+
+	if (seat->input_method ||
+	    !view_client_is_primary(seat->server, wl_resource_get_client(input_method->resource))) {
+		wlr_input_method_v2_send_unavailable(input_method);
+		return;
+	}
+
+	seat->input_method = input_method;
+	seat->input_method_destroy.notify = handle_input_method_destroy;
+	wl_signal_add(&input_method->events.destroy, &seat->input_method_destroy);
+	seat_lend_keyboard(seat);
+	seat_tell_input_method(seat, false);
+}
