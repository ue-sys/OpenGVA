+/* Whether a client is the application Cage was started for, and its views
+ * therefore the ones the others are shown under. */
+bool
+view_client_is_primary(struct cg_server *server, struct wl_client *client)
+{
+	pid_t pid = 0;
+	wl_client_get_credentials(client, &pid, NULL, NULL);
+	return server->others_under && pid != 0 && pid == server->primary_client_pid;
+}
+
+/* A view the others are shown under, if there is one. */
+struct cg_view *
+view_get_foremost(struct cg_server *server)
+{
+	struct cg_view *view;
+	wl_list_for_each (view, &server->views, link) {
+		if (view->foremost) {
+			return view;
+		}
+	}
+	return NULL;
+}
+
+/* Of the views shown under the application's, one is shown at a time: this
+ * one, or with NULL none. They are never given the keyboard, so this is
+ * also where such a view learns whether it is the one showing. */
+static void
+view_show_only(struct cg_server *server, struct cg_view *view)
+{
+	struct cg_view *other;
+	wl_list_for_each (other, &server->views, link) {
+		if (other->foremost) {
+			continue;
+		}
+		bool shown = other == view;
+		wlr_scene_node_set_enabled(&other->scene_tree->node, shown);
+		view_activate(other, shown);
+		if (other->foreign_toplevel) {
+			wlr_foreign_toplevel_handle_v1_set_minimized(other->foreign_toplevel, !shown);
+			wlr_foreign_toplevel_handle_v1_set_activated(other->foreign_toplevel, shown);
+		}
+	}
+}
+
+/* The part of the screen that the application's window does not cover - by
+ * its own account, its opaque region - is where the other clients' views
+ * go. */
+void
+view_update_clear_box(struct cg_view *view)
+{
+	struct cg_server *server = view->server;
+	if (!view->foremost || !view->wlr_surface || !view_is_primary(view)) {
+		return;
+	}
+
+	struct wlr_box layout_box;
+	wlr_output_layout_get_box(server->output_layout, NULL, &layout_box);
+
+	pixman_region32_t clear, opaque;
+	pixman_region32_init_rect(&clear, layout_box.x, layout_box.y, layout_box.width, layout_box.height);
+	pixman_region32_init(&opaque);
+	pixman_region32_copy(&opaque, &view->wlr_surface->opaque_region);
+	pixman_region32_translate(&opaque, view->lx, view->ly);
+	pixman_region32_subtract(&clear, &clear, &opaque);
+	pixman_region32_fini(&opaque);
+
+	/* A screen covered altogether leaves them where they were. */
+	struct wlr_box box = server->clear_box;
+	if (pixman_region32_not_empty(&clear)) {
+		pixman_box32_t *extents = pixman_region32_extents(&clear);
+		box.x = extents->x1;
+		box.y = extents->y1;
+		box.width = extents->x2 - extents->x1;
+		box.height = extents->y2 - extents->y1;
+	}
+	pixman_region32_fini(&clear);
+
+	if (box.x == server->clear_box.x && box.y == server->clear_box.y && box.width == server->clear_box.width &&
+	    box.height == server->clear_box.height) {
+		return;
+	}
+	server->clear_box = box;
+
+	struct cg_view *other;
+	wl_list_for_each (other, &server->views, link) {
+		if (!other->foremost) {
+			view_position(other);
+		}
+	}
+}
+
+void
+view_update_foreign_toplevel(struct cg_view *view)
+{
+	if (!view->foreign_toplevel) {
+		return;
+	}
+
+	const char *title = view->impl->get_title(view);
+	if (title) {
+		wlr_foreign_toplevel_handle_v1_set_title(view->foreign_toplevel, title);
+	}
+	const char *app_id = view->impl->get_app_id(view);
+	if (app_id) {
+		wlr_foreign_toplevel_handle_v1_set_app_id(view->foreign_toplevel, app_id);
+	}
+}
+
+static void
+handle_foreign_toplevel_request_activate(struct wl_listener *listener, void *data)
+{
+	struct cg_view *view = wl_container_of(listener, view, foreign_toplevel_request_activate);
+
+	if (!view->foremost && view_get_foremost(view->server)) {
+		view_show_only(view->server, view);
+		return;
+	}
+	wlr_scene_node_raise_to_top(&view->scene_tree->node);
+	seat_set_focus(view->server->seat, view);
+}
+
+static void
+handle_foreign_toplevel_request_minimize(struct wl_listener *listener, void *data)
+{
+	struct cg_view *view = wl_container_of(listener, view, foreign_toplevel_request_minimize);
+	struct wlr_foreign_toplevel_handle_v1_minimized_event *event = data;
+
+	/* Only a view shown under the application's can be hidden. */
+	if (view->foremost || !view_get_foremost(view->server)) {
+		return;
+	}
+	if (!event->minimized) {
+		view_show_only(view->server, view);
+	} else if (view->scene_tree->node.enabled) {
+		view_show_only(view->server, NULL);
+	}
+}
+
+static void
+view_create_foreign_toplevel(struct cg_view *view)
+{
+	view->foreign_toplevel = wlr_foreign_toplevel_handle_v1_create(view->server->foreign_toplevel_manager);
+	if (!view->foreign_toplevel) {
+		return;
+	}
+
+	view->foreign_toplevel_request_activate.notify = handle_foreign_toplevel_request_activate;
+	wl_signal_add(&view->foreign_toplevel->events.request_activate, &view->foreign_toplevel_request_activate);
+	view->foreign_toplevel_request_minimize.notify = handle_foreign_toplevel_request_minimize;
+	wl_signal_add(&view->foreign_toplevel->events.request_minimize, &view->foreign_toplevel_request_minimize);
+	view_update_foreign_toplevel(view);
+}
