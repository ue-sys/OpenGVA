#!/bin/sh
#
# Make an RPM of a tree laid out as / is:
#
#   opengva-rpm NAME LICENSE SUMMARY DIR
#
# into /rpms (RPMS= for elsewhere), at VERSION and RELEASE (0 and 1 unless
# said). Every file in DIR is in it as it is there - its mode included -
# with what is under /etc as configuration. It owns the empty directories,
# and those whose names say opengva. What its programs need - libraries,
# interpreters, the users of a sysusers.d - rpmbuild finds and it requires,
# so that dnf installs those with it. The spec is app/opengva.spec (SPEC=
# for another).

set -eu
[ $# -eq 4 ] || { echo "usage: opengva-rpm NAME LICENSE SUMMARY DIR" >&2; exit 2; }
name=$1 license=$2 summary=$3 root=$(realpath "$4")
[ -n "$(ls -A "$root")" ] || { echo "opengva-rpm: $root is empty" >&2; exit 1; }
top=$(mktemp -d)
trap 'rm -rf "$top"' EXIT

cd "$root"
{
	find . -mindepth 1 -type d \( -empty -o -name '*opengva*' \) -printf '%%dir "/%P"\n'
	find . \( -type f -o -type l \) -printf '"/%P"\n' | sed 's|^"/etc/|%config(noreplace) &|'
} | sort -u > "$top/files"

rpmbuild --quiet -bb --define "_topdir $top" --define 'source_date_epoch_from_changelog 0' --define "_rpmdir ${RPMS:-/rpms}" \
	--define '_build_name_fmt %%{NAME}-%%{VERSION}-%%{RELEASE}.%%{ARCH}.rpm' \
	--define "pkg_name $name" --define "pkg_version ${VERSION:-0}" --define "pkg_release ${RELEASE:-1}" \
	--define "pkg_summary $summary" --define "pkg_license $license" \
	--define "pkg_root $root" --define "pkg_files $top/files" \
	"${SPEC:-/usr/share/opengva/opengva.spec}"
